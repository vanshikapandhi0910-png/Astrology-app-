{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Full App (Backend + Frontend)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Backend Only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "console": "integratedTerminal",
      "restart": true
    }
  ]
}
